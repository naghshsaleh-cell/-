<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>امیرصالح نقش - کاندیدای کمیته اردویی</title>
    <style>
        body {
            margin: 0;
            font-family: 'Vazirmatn', sans-serif;
            background-color: #0b1d2e; /* رنگ سرمه ای پس زمینه */
            color: #f5f0e1; /* رنگ کرم متن ها */
            overflow-x: hidden;
        }
        #canvas-container {
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            z-index: -1; /* قرارگیری مدل سه بعدی در پس زمینه */
        }
        .hero {
            height: 100vh;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            text-align: center;
            background: linear-gradient(rgba(11, 29, 46, 0.7), rgba(11, 29, 46, 0.9));
        }
        .hero h1 {
            color: #d4b572; /* طلایی */
            font-size: 4rem;
            margin-bottom: 10px;
            text-shadow: 2px 2px 10px rgba(0,0,0,0.5);
        }
        .hero p {
            font-size: 1.5rem;
            max-width: 600px;
            line-height: 1.8;
        }
        .plans-container {
            padding: 5rem 2rem;
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 20px;
            background: #e8e2d2; /* کرم روشن مشابه پوستر */
            color: #0b1d2e;
        }
        .plan-card {
            background: white;
            padding: 20px;
            border-radius: 15px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.1);
            transition: transform 0.3s ease;
            border-bottom: 4px solid #0b1d2e;
        }
        .plan-card:hover {
            transform: translateY(-10px);
        }
    </style>
</head>
<body>

    <!-- کانتینر رندر سه بعدی واقع‌گرایانه -->
    <div id="canvas-container"></div>

    <section class="hero">
        <h1>امیرصالح نقش</h1>
        <h2>کاندیدای کمیته اردویی</h2>
        <p>اردویی متفاوت، تجربیاتی ماندگار. با رای شما، بهترین‌ها را خواهیم ساخت.</p>
    </section>

    <section class="plans-container">
        <div class="plan-card">
            <h3>تخصصی‌سازی اردوها</h3>
            <p>تخصصی‌سازی اردوهای تفریحی و گردشی با برنامه‌های جدید.</p>
        </div>
        <div class="plan-card">
            <h3>اردوهای علمی</h3>
            <p>ایجاد اردوهای علمی و پژوهشی با هدف یادگیری عملی.</p>
        </div>
        <div class="plan-card">
            <h3>توسعه مهارت‌ها</h3>
            <p>توسعه‌ی مهارت‌های رهبری و تیمی از طریق مسئولیت‌های اردویی.</p>
        </div>
        <!-- سایر کارت ها به همین ترتیب اضافه می شوند -->
    </section>

    <!-- اسکریپت پایه برای راه اندازی Three.js -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
    <script>
        // تنظیمات پایه صحنه سه بعدی
        const scene = new THREE.Scene();
        const camera = new THREE.PerspectiveCamera(75, window.innerWidth / window.innerHeight, 0.1, 1000);
        const renderer = new THREE.WebGLRenderer({ alpha: true, antialias: true });
        
        renderer.setSize(window.innerWidth, window.innerHeight);
        document.getElementById('canvas-container').appendChild(renderer.domElement);

        // اضافه کردن نورپردازی واقعی برای جلوگیری از حالت کارتونی
        const ambientLight = new THREE.AmbientLight(0xffffff, 0.6);
        scene.add(ambientLight);
        
        const directionalLight = new THREE.DirectionalLight(0xffdfb0, 0.8); // نور طلوع آفتاب
        directionalLight.position.set(5, 10, 7);
        scene.add(directionalLight);

        // در اینجا مدل های سه بعدی واقعی (مثل کوهستان یا قطب نما) با فرمت GLTF لود می شوند
        // مثال یک شکل ساده به عنوان جایگزین موقت:
        const geometry = new THREE.TorusGeometry(10, 3, 16, 100);
        const material = new THREE.MeshStandardMaterial({ color: 0xd4b572, roughness: 0.2, metalness: 0.8 });
        const torus = new THREE.Mesh(geometry, material);
        scene.add(torus);

        camera.position.z = 30;

        function animate() {
            requestAnimationFrame(animate);
            // چرخش آرام و باوقار
            torus.rotation.x += 0.002;
            torus.rotation.y += 0.003;
            renderer.render(scene, camera);
        }
        animate();

        // واکنش گرا کردن بوم سه بعدی
        window.addEventListener('resize', () => {
            camera.aspect = window.innerWidth / window.innerHeight;
            camera.updateProjectionMatrix();
            renderer.setSize(window.innerWidth, window.innerHeight);
        });
    </script>
</body>
</html>
